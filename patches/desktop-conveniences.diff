+void
+togglescratch(const Arg *arg)
+{
+	Client *c = NULL, *t;
+	Monitor *m;
+
+	for (m = mons; m && !c; m = m->next)
+		for (t = m->clients; t; t = t->next)
+			if (t->isscratchpad) {
+				c = t;
+				break;
+			}
+	if (!c) {
+		spawn(arg);
+		return;
+	}
+	if (ISVISIBLE(c) && c->mon == selmon) {
+		c->tags = SCRATCHTAG;
+		focus(NULL);
+		arrange(c->mon);
+		warp(NULL);
+		return;
+	}
+	if (c->mon != selmon)
+		sendmon(c, selmon);
+	c->tags = selmon->tagset[selmon->seltags];
+	focus(c);
+	arrange(c->mon);
+	restack(selmon);
+	warp(c);
+}
